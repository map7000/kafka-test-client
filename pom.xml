<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>ru.mfilatov</groupId>
  <artifactId>kafka-test-client-parent</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>
  
  <modules>
    <module>kafka-test-client-core</module>
    <module>kafka-test-client-service</module>
  </modules>

  <properties>
        <!-- Build Settings -->
        <java.version>24</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <maven.compiler.proc>full</maven.compiler.proc>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Dependency Versions -->
        <spring-boot.version>4.1.2</spring-boot.version>
        <lombok.version>1.18.48</lombok.version>
        <logback.version>1.6.5</logback.version>
        <junit.version>6.1.3</junit.version>
        <junit-platform.version>6.1.3</junit-platform.version>
        <assertj.version>3.27.7</assertj.version>
        <kafka.version>4.4.0</kafka.version>
        <awaitility.version>4.3.0</awaitility.version>
        <allure.version>2.35.5</allure.version>
        <aspectj.version>1.9.26</aspectj.version>

        <!-- Plugin Versions -->
        <compiler.version>3.16.0</compiler.version>
        <surefire.version>3.6.0</surefire.version>
        <spotless.version>3.10.4</spotless.version>
    </properties>


    <build>
        <plugins>
            <!-- Spotless (Code Formatting) -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless.version}</version>
                <configuration>
                    <java>
                        <cleanthat />
                        <googleJavaFormat />
                        <removeUnusedImports />
                        <formatAnnotations />

                        <licenseHeader>
                            <content>
/*
* Copyright 2025 Mikhail Filatov
* SPDX-License-Identifier: Apache-2.0
*/
                            </content>
                        </licenseHeader>

                        <includes>
                            <include>src/**/*.java</include>
                        </includes>

                        <excludes>
                            <exclude>**/target/**</exclude>
                            <exclude>**/generated/**</exclude>
                        </excludes>
                    </java>
                </configuration>
            </plugin>
        </plugins>
    </build>
  
</project>